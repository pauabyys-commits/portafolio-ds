# Server

server <- function(input, output, session) {

  # Generador según la distribución elegida

  generar_poblacion <- function(n, distribucion) {
    switch(distribucion,
      uniforme = runif(n, 0, 10),
      exponencial = rexp(n, rate = 0.5),
      bimodal = c(rnorm(n / 2, mean = 2, sd = 0.8), rnorm(n - floor(n / 2), mean = 8, sd = 0.8)),
      extrema = rbeta(n, 0.3, 8) * 10
    )
  }

  parametros_teoricos <- reactive({
    # Aproximamos media y varianza teóricas por Monte Carlo
    set.seed(1)
    muestra_grande <- generar_poblacion(200000, input$distribucion)
    list(media = mean(muestra_grande), sd = sd(muestra_grande))
  })

  poblacion_muestra <- reactive({
    input$resimular
    set.seed(NULL)
    generar_poblacion(5000, input$distribucion)
  })

  medias_simuladas <- reactive({
    input$resimular
    n <- input$n
    replicate(input$n_muestras, mean(generar_poblacion(n, input$distribucion)))
  })

  # Value boxes

  output$media_teorica <- renderText({
    round(parametros_teoricos()$media, 2)
  })

  output$se_teorico <- renderText({
    p <- parametros_teoricos()
    round(p$sd / sqrt(input$n), 3)
  })

  output$se_observado <- renderText({
    round(sd(medias_simuladas()), 3)
  })

  output$nota_TLC <- renderUI({
    if (input$n <= 2) {
      div(class = "nota", "Con n tan chico, todavía se nota la forma original — sube el slider de tamaño de muestra para ver la transformación.")
    } else if (input$n >= 30) {
      div(class = "nota", "Con n ≥ 30 la distribución ya es prácticamente una normal, sin importar qué tan rara era la población original — esto es el TLC en acción.")
    }
  })

  # Gráfica: población

  output$pop_plot <- renderPlot({
    df <- data.frame(x = poblacion_muestra())

    ggplot(df, aes(x)) +
      geom_histogram(bins = 40, fill = ACENTO, color = FONDO, alpha = 0.75, linewidth = 0.2) +
      labs(x = "Valor individual", y = "Frecuencia") +
      theme_minimal(base_size = 14, base_family = "sans") +
      theme(
        plot.background = element_rect(fill = FONDO, color = NA),
        panel.background = element_rect(fill = FONDO, color = NA),
        panel.grid.major = element_line(color = LINEA, linewidth = 0.3),
        panel.grid.minor = element_blank(),
        text = element_text(color = TINTA),
        axis.text = element_text(color = GRIS)
      )
  }, bg = FONDO)

  # Gráfica: distribución de la media

  output$TLC_plot <- renderPlot({
    medias <- medias_simuladas()
    p <- parametros_teoricos()
    se_teo <- p$sd / sqrt(input$n)

    df <- data.frame(x = medias)
    x_seq <- seq(min(medias), max(medias), length.out = 300)
    normal_teorica <- data.frame(x = x_seq, y = dnorm(x_seq, p$media, se_teo))

    ggplot(df, aes(x)) +
      geom_histogram(aes(y = after_stat(density)), bins = 40, fill = ACENTO, color = FONDO, alpha = 0.45, linewidth = 0.2) +
      geom_line(data = normal_teorica, aes(x, y), color = TINTA, linewidth = 1) +
      labs(x = "Media de cada muestra", y = "Densidad",
           subtitle = paste0("n = ", input$n, " · línea negra = normal teórica (TLC)")) +
      theme_minimal(base_size = 14, base_family = "sans") +
      theme(
        plot.background = element_rect(fill = FONDO, color = NA),
        panel.background = element_rect(fill = FONDO, color = NA),
        panel.grid.major = element_line(color = LINEA, linewidth = 0.3),
        panel.grid.minor = element_blank(),
        text = element_text(color = TINTA),
        axis.text = element_text(color = GRIS),
        plot.subtitle = element_text(color = GRIS, family = "mono", size = 11)
      )
  }, bg = FONDO)
}

shinyApp(ui, server)
