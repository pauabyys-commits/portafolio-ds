# "Incertidumbre visible" — ¿qué % de pacientes responde al tratamiento?
# Estimación bayesiana de tasas de respuesta en varios hospitales,
# con "partial pooling" (shrinkage): los sitios con pocos pacientes se
# jalan hacia el promedio general.
#
# Método: Empirical Bayes Beta-Binomial (moments)

library(shiny)
library(bslib)
library(ggplot2)
library(dplyr)
library(tidyr)
library(scales)

options(shiny.maxRequestSize = 200 * 1024^2)

# Datos de ejemplo: tomados del dataset CMS "Readmissions and Deaths - Hospital" (Medicare / CMS, EE.UU.)
# Indicador: Rate of readmission for heart failure (HF) a 30 días.
# 12 hospitales de Texas

datos_ilustrativos <- data.frame(
  sitio = c("Goodall Witcher Hospital", "Seymour Hospital", "Walnut Hill Medical Center",
            "St Marks Medical Center", "Harris Health System", "Odessa Regional Medical Center",
            "TX Health Heart & Vascular Arlington", "Providence Memorial Hospital",
            "Mission Regional Medical Center", "Shannon Medical Center",
            "Memorial Hermann Memorial City", "Methodist Hospital"),
  pacientes = c(25, 37, 65, 102, 128, 172, 212, 280, 360, 474, 711, 2312),
  respondieron = round(c(25, 37, 65, 102, 128, 172, 212, 280, 360, 474, 711, 2312) *
                       c(21.8, 22.0, 22.6, 21.6, 22.4, 19.8, 21.0, 19.8, 23.1, 18.2, 20.7, 21.5) / 100),
  stringsAsFactors = FALSE
)

