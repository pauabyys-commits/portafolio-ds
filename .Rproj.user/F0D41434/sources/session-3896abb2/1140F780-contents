# Server

server <- function(input, output, session) {

  # Cargar el CSV

  datos_crudos <- reactive({
    if (is.null(input$archivo_cms)) {
      return(NULL)   # usamos datos_ilustrativos directamente más abajo
    }
    df <- tryCatch(read.csv(input$archivo_cms$datapath, stringsAsFactors = FALSE),
                    error = function(e) NULL)
    validate(need(!is.null(df) && all(c("Hospital.Name", "State", "Measure.Name",
                                          "Denominator", "Score") %in% names(df)),
                   "El CSV no tiene las columnas esperadas del dataset CMS (Hospital Name, State, Measure Name, Denominator, Score)."))
    df
  })

  output$selector_estado <- renderUI({
    df <- datos_crudos()
    req(df)
    selectInput("estado_cms", "Estado", choices = sort(unique(df$State)), selected = "TX")
  })

  output$selector_indicador <- renderUI({
    df <- datos_crudos()
    req(df)
    selectInput("indicador_cms", "Indicador", choices = sort(unique(df$Measure.Name)))
  })

  # Construir la tabla (hospital, pacientes, eventos) 

  datos_validos <- reactive({
    df_crudo <- datos_crudos()

    if (is.null(df_crudo)) {
      df <- datos_ilustrativos
    } else {
      req(input$estado_cms, input$indicador_cms)
      df <- df_crudo %>%
        filter(State == input$estado_cms, Measure.Name == input$indicador_cms) %>%
        mutate(
          pacientes = suppressWarnings(as.numeric(Denominator)),
          score = suppressWarnings(as.numeric(Score))
        ) %>%
        filter(!is.na(pacientes), !is.na(score), pacientes > 0) %>%
        transmute(
          sitio = Hospital.Name,
          pacientes,
          respondieron = round(score / 100 * pacientes)
        ) %>%
        arrange(pacientes)

      n_disp <- nrow(df)
      if (n_disp > input$max_hospitales) {
        idx <- round(seq(1, n_disp, length.out = input$max_hospitales))
        df <- df[idx, ]
      }
    }

    validate(need(nrow(df) >= 3, "Muy pocos hospitales con datos válidos para este estado/indicador — prueba otra combinación."))
    df
  })

  # Estimación Empirical Bayes: hiperparámetros del Beta poblacional

  hiperparametros <- reactive({
    df <- datos_validos()
    p_hat <- df$respondieron / df$pacientes

    m <- mean(p_hat)
    v <- var(p_hat)

    # Método de momentos para Beta(a,b)
    if (is.na(v) || v <= 0 || v >= m * (1 - m)) {
      a <- 1; b <- 1
    } else {
      comun <- m * (1 - m) / v - 1
      a <- max(m * comun, 0.1)
      b <- max((1 - m) * comun, 0.1)
    }
    list(a = a, b = b)
  })

  # Posterior por sitio

  posteriores <- reactive({
    df <- datos_validos()
    hp <- hiperparametros()

    df %>%
      mutate(
        tasa_cruda = respondieron / pacientes,
        a_post = hp$a + respondieron,
        b_post = hp$b + pacientes - respondieron,
        tasa_bayes = a_post / (a_post + b_post),
        ic_bajo = qbeta(0.025, a_post, b_post),
        ic_alto = qbeta(0.975, a_post, b_post)
      ) %>%
      arrange(pacientes)
  })

  # Value boxes

  output$tasa_general <- renderText({
    hp <- hiperparametros()
    percent(hp$a / (hp$a + hp$b), accuracy = 0.1)
  })

  output$n_sitios <- renderText({
    nrow(datos_validos())
  })

  output$variabilidad <- renderText({
    df <- datos_validos()
    p_hat <- df$respondieron / df$pacientes
    percent(sd(p_hat), accuracy = 0.1)
  })

  # Gráfica : shrinkage 

  output$shrink_plot <- renderPlot({
    df <- posteriores()
    df$sitio_wrap <- vapply(df$sitio, function(s) paste(strwrap(s, width = 28), collapse = "\n"), character(1))
    df$sitio_wrap <- factor(df$sitio_wrap, levels = unique(df$sitio_wrap))   # respeta el orden por tamaño

    ggplot(df, aes(y = sitio_wrap)) +
      geom_vline(xintercept = hiperparametros()$a / sum(unlist(hiperparametros())),
                 linetype = "dashed", color = "#6FE7C4", alpha = 0.6) +
      geom_segment(aes(x = tasa_cruda, xend = tasa_bayes, yend = sitio_wrap),
                   color = "#4C4870", linewidth = 0.8) +
      geom_errorbarh(aes(xmin = ic_bajo, xmax = ic_alto), color = "#9C8FE8", height = 0.15, alpha = 0.5) +
      geom_point(aes(x = tasa_cruda), shape = 21, size = 3.5, color = "#E8A24E", fill = "#1E1B2E", stroke = 1.4) +
      geom_point(aes(x = tasa_bayes), shape = 21, size = 3.5, color = "#9C8FE8", fill = "#9C8FE8") +
      scale_x_continuous(labels = percent_format(accuracy = 1)) +
      labs(x = "Tasa observada", y = NULL) +
      theme_minimal(base_size = 13, base_family = "Inter") +
      theme(
        plot.background = element_rect(fill = "#1E1B2E", color = NA),
        panel.background = element_rect(fill = "#1E1B2E", color = NA),
        panel.grid.major.y = element_blank(),
        panel.grid.minor = element_blank(),
        panel.grid.major.x = element_line(color = "#2C2842"),
        text = element_text(color = "#F0ECE4"),
        axis.text = element_text(color = "#A79FC0"),
        axis.text.y = element_text(size = 9, lineheight = 0.85),
        plot.margin = margin(10, 20, 10, 10)
      )
  }, bg = "#1E1B2E", height = function() max(500, 40 * nrow(posteriores())))

  # Gráfica : distribución poblacional (hyper-Beta)

  output$poblacional_plot <- renderPlot({
    hp <- hiperparametros()
    x_seq <- seq(0, 1, length.out = 600)
    df <- data.frame(x = x_seq, densidad = dbeta(x_seq, hp$a, hp$b))

    ggplot(df, aes(x, densidad)) +
      geom_area(fill = "#9C8FE8", alpha = 0.15) +
      geom_line(color = "#9C8FE8", linewidth = 1.2) +
      scale_x_continuous(labels = percent_format(accuracy = 1)) +
      labs(x = "Tasa de respuesta esperada en un sitio nuevo", y = "Densidad") +
      theme_minimal(base_size = 15, base_family = "Inter") +
      theme(
        plot.background = element_rect(fill = "#1E1B2E", color = NA),
        panel.background = element_rect(fill = "#1E1B2E", color = NA),
        panel.grid.major = element_line(color = "#2C2842"),
        panel.grid.minor = element_blank(),
        text = element_text(color = "#F0ECE4"),
        axis.text = element_text(color = "#A79FC0")
      )
  }, bg = "#1E1B2E")
}

shinyApp(ui, server)
